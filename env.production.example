# === Variables de entorno para producción ===
# Copiar como .env.production en el servidor:  cp env.production.example .env.production

# Base de datos SQLite (archivo dentro del volumen persistente del contenedor).
# No hace falta cambiarlo: apunta al volumen bitacora-data montado en /app/data.
DATABASE_URL="file:/app/data/prod.db"

# NextAuth - CAMBIAR el secret por uno seguro
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIAR-POR-UN-SECRET-SEGURO-DE-32-CARACTERES"

# NextAuth URL - Cambiar por la IP o dominio real donde se accede a la app.
# Incluye el basePath /bitacora. Ejemplos:
#   http://192.168.1.50:3000/bitacora   (acceso directo por IP del LXC)
#   https://tudominio.com/bitacora      (detrás de reverse proxy con HTTPS)
NEXTAUTH_URL="http://IP-DEL-LXC:3000/bitacora"
